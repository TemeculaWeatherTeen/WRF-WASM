# Shared settings, sourced by the workflows and scripts.
# Edit here, push, and re-run the workflows.

# --- Source versions -------------------------------------------------------
WRF_REF=v4.7.1          # WRF 4.8.0 (June 2026) is the newest release; 4.7.1 is the conservative choice
WPS_REF=v4.6.0
NETCDF_C_VERSION=4.9.2
NETCDF_F_VERSION=4.6.1

# --- Domain: rectangle from San Luis Obispo (NW) to Yuma, AZ (SE) ----------
BBOX_N=35.4
BBOX_S=32.5
BBOX_W=-121.0
BBOX_E=-114.3
TRUELAT=34.0
# Horizontal grid spacing in metres. 12 km keeps a 24 h run in the tens-of-minutes
# range for single-threaded wasm; 6000 is ~8x the cost. e_we/e_sn are derived from this.
DX=12000
E_VERT=33

# --- Forecast --------------------------------------------------------------
MAX_HOURS=72            # boundary conditions are prepared for this many hours
BDY_INTERVAL_H=3        # GFS boundary interval
HISTORY_INTERVAL_MIN=60 # one wrfout frame per hour
